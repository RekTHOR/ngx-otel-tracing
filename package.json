{
  "name": "ngx-otel-tracing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build ngx-otel-tracing",
    "test": "ng test ngx-otel-tracing",
    "test:ci": "ng test ngx-otel-tracing --watch=false --browsers=ChromeHeadlessCI",
    "pack:local": "ng build ngx-otel-tracing && npm pack ./dist/ngx-otel-tracing --pack-destination .local-pack"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.38",
    "@angular/cli": "^20.3.38",
    "@angular/compiler-cli": "^20.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-web": "^0.67.0",
    "@opentelemetry/context-zone": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2",
    "web-vitals": "^6.2.3",
    "zone.js": "^0.15.1"
  }
}
